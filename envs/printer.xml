<mujoco model="my_task">
  <include file="../so101/Simulation/SO101/so101_new_calib.xml"/>
  <compiler meshdir="../so101/Simulation/SO101/assets"/>

  <worldbody>
    <light pos="0 0 2"/>
    <geom type="plane" size="1 1 0.1" rgba="0.9 0.9 0.9 1"/>

    <!-- printer, fixed to the world (no freejoint), front faces the arm -->
    <body name="printer" pos="0.35 0 0">
      <geom name="printer_base" type="box" size="0.15 0.15 0.02" pos="0 0 0.02" rgba=".2 .2 .2 1"/>
      <geom name="upright_l" type="box" size="0.01 0.01 0.18" pos="0  0.16 0.2" rgba=".3 .3 .3 1"/>
      <geom name="upright_r" type="box" size="0.01 0.01 0.18" pos="0 -0.16 0.2" rgba=".3 .3 .3 1"/>
      <geom name="top_bar"   type="box" size="0.01 0.17 0.01" pos="0 0 0.39"   rgba=".3 .3 .3 1"/>

      <!-- bed slides toward/away from the arm -->
      <body name="bed" pos="0 0 0.05">
        <joint name="bed_x" type="slide" axis="1 0 0" range="-0.1 0.1"/>
        <geom name="bed_plate" type="box" size="0.11 0.11 0.005" rgba=".75 .75 .75 1"/>
      </body>

      <!-- gantry moves up/down, toolhead moves side to side -->
      <body name="gantry" pos="0 0 0.25">
        <joint name="gantry_z" type="slide" axis="0 0 1" range="-0.15 0.1"/>
        <geom name="gantry_bar" type="box" size="0.01 0.14 0.01" rgba=".3 .3 .3 1"/>
        <body name="toolhead">
          <joint name="head_y" type="slide" axis="0 1 0" range="-0.11 0.11"/>
          <geom name="toolhead_box" type="box" size="0.025 0.03 0.035" pos="-0.035 0 0" rgba=".1 .4 .8 1"/>
        </body>
      </body>
    </body>

    <!-- a "printed part" sitting on the bed -->
    <body name="part" pos="0.33 0 0.07">
      <freejoint/>
      <geom name="part" type="box" size="0.012 0.012 0.012" rgba="1 .5 0 1" mass="0.01"/>
    </body>
  </worldbody>

  <actuator>
    <position name="bed"     joint="bed_x"    kp="200" ctrlrange="-0.1 0.1"/>
    <position name="gantry"  joint="gantry_z" kp="500" ctrlrange="-0.15 0.1"/>
    <position name="head"    joint="head_y"   kp="200" ctrlrange="-0.11 0.11"/>
  </actuator>
</mujoco>
